{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Zhizhi platform configuration example",
  "type": "object",
  "required": [
    "schema_version",
    "run_worker",
    "auto_commit"
  ],
  "properties": {
    "enabled": {
      "type": "boolean"
    },
    "run_worker": {
      "type": "boolean"
    },
    "auto_commit": {
      "type": "boolean"
    },
    "providers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
