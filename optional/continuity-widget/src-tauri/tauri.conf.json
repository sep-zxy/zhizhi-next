{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Continuity",
  "version": "0.3.0",
  "identifier": "com.zxy.continuity-widget",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Continuity 项目工作区",
        "width": 1280,
        "height": 800,
        "minWidth": 760,
        "minHeight": 560,
        "resizable": true,
        "decorations": true,
        "transparent": false,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "shadow": true,
        "center": true,
        "visible": true
      },
      {
        "label": "widget",
        "title": "Continuity 紧凑组件",
        "width": 450,
        "height": 720,
        "minWidth": 420,
        "minHeight": 560,
        "maxWidth": 520,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "center": false,
        "visible": false
      },
      {
        "label": "preview",
        "title": "项目预览",
        "width": 360,
        "height": 720,
        "resizable": false,
        "decorations": false,
        "transparent": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": true,
        "center": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: https://asset.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["../assets/continuity-icon.png", "../assets/continuity-widget.ico"]
  }
}
